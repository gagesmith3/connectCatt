# Polling interval in seconds (minimum 5)
CAST_CHECK_INTERVAL_SECONDS=20

# Relative to project root, unless absolute path
CAST_STATE_FILE=cast_scheduler_state.json

# Preferred: keep jobs in a JSON file for readability
CAST_JOBS_FILE=config/cast_jobs.json

# Optional alternative: inline JSON (leave empty when using CAST_JOBS_FILE)
CAST_JOBS=
